<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sitenetsoft</groupId>
    <artifactId>quarkus-topaz-security-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>quarkus-topaz-security-no-rest-tests</artifactId>
  <name>Topaz Security - No REST Tests</name>

  <properties>
    <!-- test-only application, never published -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- Deliberately no quarkus-rest*: proves the extension builds and enforces without Quarkus REST. -->
  <dependencies>
    <dependency>
      <groupId>org.sitenetsoft</groupId>
      <artifactId>quarkus-topaz-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-reactive-routes</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-elytron-security-properties-file</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Ensure the deployment module is built before this one in the reactor -->
    <dependency>
      <groupId>org.sitenetsoft</groupId>
      <artifactId>quarkus-topaz-security-deployment</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
